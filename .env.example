# listalaboda.com environment template.
# Copy to .env.local for local development. Never commit real values.
# Local values come from `npx supabase status` once the local stack runs.

# --- Public (inlined into the browser bundle; must be safe to publish) ---
# Supabase project URL, e.g. http://127.0.0.1:54321 locally.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). A legacy anon JWT also works.
# NEVER put a secret / service-role key here — the app refuses to start.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (never prefixed with NEXT_PUBLIC_) ---
# Secret / service-role key (sb_secret_... or a legacy service_role JWT).
# Bypasses RLS. Its ONLY uses: ADR-004/ADR-005/ADR-007 — src/lib/email/delivery-recorder.ts
# records that the email provider accepted an invitation, RSVP confirmation or
# RSVP reminder email, and reads a party's private confirmation context by its
# link's hash; and ADR-010 (LB-17) — src/lib/scheduler/rsvp-reminder-store.ts
# drives the automatic RSVP reminder scheduler's five service_role-only functions;
# and ADR-011 (LB-18.2) — src/lib/email/delivery-event-store.ts ingests signed
# Resend delivery webhooks through one service_role-only function.
# Required for sending those emails; everything else (RSVPs included) works
# without it. Never prefix it with NEXT_PUBLIC_. Locally: SECRET_KEY from
# `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# --- RSVP link recovery (server only; LB-13, ADR-006) ---
# base64url-encoded 32-byte secret; generate securely and keep stable.
# Encrypts each party's RSVP link so organizers can show the SAME link again
# ("Mostrar enlace"). Required to create parties and generate new links (they
# fail safely without it). Never prefix it with NEXT_PUBLIC_, never commit a
# real value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing or losing it makes stored links unrecoverable (guest links keep
# working; an owner can generate a new link). Keep it apart from DB backups.
# RSVP links (fresh, emailed, recovered) are always built from APP_ORIGIN
# below (no email provider needed); both are required to create parties.
RSVP_CAPABILITY_ENCRYPTION_KEY=

# --- Email (server only; LB-11 invitation, LB-12 RSVP confirmation and LB-14 RSVP reminder emails through Resend) ---
# Without these (and SUPABASE_SERVICE_ROLE_KEY above), sending an invitation
# fails safely ("El correo no está configurado todavía") and RSVPs are saved
# without a confirmation email; everything else, including copyable links, works.
# APP_ORIGIN is also REQUIRED for guest links (LB-13): the trusted origin of
# every absolute RSVP link (fresh, emailed, recovered) and of the wedding
# website link in emails, e.g. https://your-domain.example. Never derived from
# request headers. Password recovery links (AUTH-RECOVERY-01) return to
# APP_ORIGIN/auth/callback, so that URL must be in Supabase Auth's redirect
# allow-list (production: https://listalaboda.com).
APP_ORIGIN=
# Sender on a domain verified in Resend, e.g. ListaLaBoda <invitaciones@your-domain.example>.
EMAIL_FROM=
# Resend API key. Secret: never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=
# Optional. "resend" (default) or "outbox" (writes each email to a file in
# EMAIL_OUTBOX_DIR instead of sending; only accepted with a localhost
# APP_ORIGIN — used by the E2E suite).
EMAIL_TRANSPORT=
EMAIL_OUTBOX_DIR=

# --- Automatic RSVP reminders (server only; LB-17, ADR-010) ---
# Bearer secret for GET /api/cron/rsvp-reminders (Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"). At least 32 characters, no spaces;
# generate it yourself and never commit a real value. Read only by
# src/lib/scheduler/cron-auth.ts. Without it the route refuses (503) and
# nothing is sent. NOT ACTIVATED: no cron schedule is configured in this
# repository; production activation is a separately approved step. The
# scheduler also needs SUPABASE_SERVICE_ROLE_KEY, RSVP_CAPABILITY_ENCRYPTION_KEY,
# APP_ORIGIN and the email settings above.
CRON_SECRET=

# --- Email delivery webhooks (server only; LB-18.2, ADR-011) ---
# Resend's webhook signing secret (whsec_...), used to verify the Svix
# signature of POST /api/webhooks/resend. Read only by
# src/lib/email/webhook-auth.ts. Needed only when that endpoint is exercised
# or activated; without it the route refuses (503) and records nothing.
# NOT PROVISIONED in production by LB-18.2: creating the Resend webhook and
# setting this value is a separately approved step. Never commit a real value.
RESEND_WEBHOOK_SECRET=

# --- Billing (server only; BILLING-01, ADR-021) ---
# Stripe Checkout (hosted) and the Customer Portal are created server-side, so
# there is NO publishable key. Use TEST-MODE values (sk_test_..., test prices)
# everywhere except an explicitly approved production rollout. Never commit a
# real value. Without all four (plus APP_ORIGIN, NEXT_PUBLIC_SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY) billing is "not available": nothing is sold, the
# webhook refuses (503) and nothing else changes.
# Secret API key (sk_test_... / rk_test_...). Read only by src/lib/billing/stripe-gateway.ts.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_...), for POST /api/stripe/webhook.
# Read only by src/lib/billing/webhook-auth.ts. Locally: printed by
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Stripe Price ids (price_...): billing configuration, never authorization.
# Amounts and currencies live in Stripe; the code hardcodes none.
# A RECURRING monthly price (planner accounts, Checkout mode=subscription).
STRIPE_PLANNER_MONTHLY_PRICE_ID=
# A ONE-TIME price (couple accounts, Checkout mode=payment).
STRIPE_COUPLE_ONE_TIME_PRICE_ID=
# Optional, LOCAL TOOLING ONLY: points the Stripe SDK at a local Stripe
# stand-in (the E2E suite's). Refused unless it and APP_ORIGIN are localhost.
STRIPE_API_BASE=
